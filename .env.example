# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ---- LLM Provider (9router or ollama) ----
LLM_PROVIDER=ollama

# ---- Ollama / Qwen ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=kamekichi128/qwen3-4b-instruct-2507:latest

# ---- 9router / gemini ----
# NINEROUTER_BASE_URL=http://localhost:20128/v1
# NINEROUTER_API_KEY=sk-your-9router-key
# NINEROUTER_MODEL=ag/gemini-3.8-flash

# ---- Blaze ----
BLAZE_API_KEY=your_blaze_api_key

# ---- SOAP local demo (enabled by default in development/test) ----
SOAP_ENABLED=true
DB_AUTO_CREATE_TABLES=true
SOAP_DATA_DIR=./data/soap_mvp
SOAP_MAX_TURNS=200
SOAP_MAX_CHARS=30000
SOAP_MAX_INPUT_BYTES=1000000
SOAP_LLM_TIMEOUT=45
SOAP_LLM_TEMPERATURE=0

# ---- ICD-10 (icd.kcb.vn via Parse). Key: https://parse.bot/settings ----
PARSE_API_KEY=
PARSE_ICD_BASE_URL=https://api.parse.bot/scraper/f43e4b76-2a78-47fd-b08d-13fc8f3dbba3
# SOAP_LLM_MODEL=ag/gemini-3.8-flash
## Optional providers selected in Settings (model ID comes from each provider).
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
